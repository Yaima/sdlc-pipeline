{
  "$comment": "Repo-specific commands and loop limits. Agents and hooks read this file. Set the commands for this repo; leave \"\" if the repo has none. Per-person settings (role) go in docs/pipeline/pipeline.local.json, which is gitignored. test_globs lists common layouts for Go, Python, JavaScript/TypeScript, and Java; trim it to this repo's. security_cmd is the repo's own scanner (examples: gosec ./... or govulncheck ./...; bandit -r . && pip-audit; npm audit --audit-level=high; semgrep --config auto; gitleaks detect). It runs like lint_cmd: by the reviewer, in the evidence gate, and in CI with check-feature.sh --run.",
  "test_cmd": "",
  "test_file_cmd": "",
  "lint_cmd": "",
  "typecheck_cmd": "",
  "security_cmd": "",
  "format_cmd": "",
  "coverage_cmd": "",
  "test_globs": [
    "**/*_test.go",
    "**/*_suite_test.go",
    "**/testdata/**",
    "**/test_*.py",
    "**/*_test.py",
    "**/tests/**",
    "**/conftest.py",
    "**/*.test.js",
    "**/*.test.jsx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.js",
    "**/*.spec.ts",
    "**/__tests__/**",
    "**/src/test/**"
  ],
  "protected_config_globs": [
    ".github/**",
    ".gitlab-ci.yml",
    "Makefile",
    "**/.eslintrc*",
    "**/eslint.config.*",
    "**/.golangci.*",
    "**/pyproject.toml",
    "**/setup.cfg",
    "**/tsconfig*.json",
    "**/jest.config.*",
    "**/vitest.config.*",
    "**/pytest.ini",
    "**/conftest.py",
    ".claude/**",
    ".codex/**",
    ".gemini/**",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "docs/pipeline/pipeline.json",
    "docs/pipeline/rules/**",
    "docs/pipeline/roles/**",
    "docs/pipeline/stages/**",
    "docs/pipeline/enforcement/**"
  ],
  "protected_branches": [
    "develop",
    "main",
    "master",
    "release/*"
  ],
  "base_branch": "main",
  "max_review_rounds": 3,
  "max_task_loc": 300,
  "second_review_on_blast_radius": [
    "high"
  ],
  "second_review_method": "code-review-plugin",
  "min_coverage_percent": 0,
  "docs_dir": "docs/features",
  "pr_tool": "gh",
  "commit_mode": "human",
  "max_analyst_rounds": 2
}
